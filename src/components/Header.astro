---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/software/hvac/', label: 'HVAC' },
  { href: '/software/plumbing/', label: 'Plumbing' },
  { href: '/software/electrical/', label: 'Electrical' },
  { href: '/comparisons/', label: 'Comparisons' },
  { href: '/guides/', label: 'Guides' },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="FieldServicePros home">
      <span class="logo-icon">&lt;/&gt;</span>
      <span class="logo-text">FieldService<span class="logo-highlight">Pros</span></span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map(item => (
          <li><a href={item.href} class="nav-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/comparisons/" class="btn btn-primary header-cta">Compare Software</a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>
</header>

<style>
.header {
  background: var(--color-white);
  border-bottom: 1px solid var(--color-gray-200);
  position: sticky;
  top: 0;
  z-index: 100;
}
.header-inner {
  display: flex;
  align-items: center;
  gap: var(--space-8);
  height: 64px;
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--color-gray-900);
  text-decoration: none;
  white-space: nowrap;
}
.logo-icon {
  font-family: var(--font-mono);
  color: var(--color-primary);
  font-size: 1.5rem;
}
.logo-highlight {
  color: var(--color-primary);
}
.logo:hover { text-decoration: none; }
.nav { flex: 1; }
.nav-list {
  display: flex;
  gap: var(--space-1);
  list-style: none;
  padding: 0;
  margin: 0;
}
.nav-link {
  padding: var(--space-2) var(--space-3);
  font-size: 0.9375rem;
  color: var(--color-gray-600);
  border-radius: var(--border-radius);
  font-weight: 500;
  transition: all var(--transition);
}
.nav-link:hover {
  color: var(--color-primary);
  background: var(--color-gray-50);
  text-decoration: none;
}
.header-cta {
  white-space: nowrap;
}
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--space-2);
}
.nav-toggle-bar {
  width: 24px;
  height: 2px;
  background: var(--color-gray-900);
  border-radius: 2px;
}
@media (max-width: 768px) {
  .nav, .header-cta { display: none; }
  .nav-toggle { display: flex; }
  .nav-open .nav { display: block; }
}
</style>
