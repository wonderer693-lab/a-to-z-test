---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resource');
const caseStudy = resources.find(r => r.data.type === 'case-study');
const body = caseStudy ? caseStudy.body : '';
---

<BaseLayout title="Contractor Success Stories - Field Service Software Case Studies" description="Real stories from contractors who transformed their businesses with field service management software.">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/guides/">Resources</a></li><li aria-current="page">Case Studies</li></ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="container">
      <h1>Contractor Success Stories</h1>
      <p>Real stories from contractors who switched to field service software and transformed their businesses.</p>
    </div>
  </section>

  <section class="section">
    <div class="container case-studies-content content">
      <div set:html={body} />
    </div>
  </section>
</BaseLayout>

<style>
.breadcrumbs { padding: var(--space-4) 0; }
.breadcrumbs ol { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin: 0; }
.breadcrumbs li { font-size: 0.875rem; color: var(--color-gray-500); }
.breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); color: var(--color-gray-300); }
.breadcrumbs a { color: var(--color-gray-500); }
.breadcrumbs [aria-current] { color: var(--color-gray-700); font-weight: 500; }
.page-hero { background: var(--color-gray-50); padding: var(--space-12) 0; border-bottom: 1px solid var(--color-gray-200); }
.page-hero h1 { margin-bottom: var(--space-3); }
.page-hero p { color: var(--color-gray-600); max-width: 640px; font-size: 1.0625rem; }
.section { padding: var(--space-12) 0; }
.case-studies-content { line-height: 1.7; }
.case-studies-content h2 { margin-top: var(--space-8); }
.case-studies-content p { color: var(--color-gray-700); }
</style>
