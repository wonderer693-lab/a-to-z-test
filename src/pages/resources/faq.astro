---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resource');
const faq = resources.find(r => r.data.type === 'faq');
const body = faq ? faq.body : '';

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does field service software cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Most field service tools range from $49 to $500 per month depending on features and tech count." }
    },
    {
      "@type": "Question",
      "name": "What is the best field service software for small contractors?",
      "acceptedAnswer": { "@type": "Answer", "text": "For 1-5 tech crews, Housecall Pro is our top recommendation." }
    },
    {
      "@type": "Question",
      "name": "Does field service software integrate with QuickBooks?",
      "acceptedAnswer": { "@type": "Answer", "text": "Most field service tools integrate with QuickBooks. Higher-end tools offer two-way sync." }
    }
  ]
};
---

<BaseLayout title="Field Service Software FAQ - Common Questions Answered" description="Frequently asked questions about field service management software for HVAC, plumbing, and electrical contractors." jsonLd={schema}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/guides/">Resources</a></li><li aria-current="page">FAQ</li></ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="container">
      <h1>Frequently Asked Questions</h1>
      <p>Common questions about field service management software for contractors.</p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-content">
      <div set:html={body} />
    </div>
  </section>
</BaseLayout>

<style>
.breadcrumbs { padding: var(--space-4) 0; }
.breadcrumbs ol { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin: 0; }
.breadcrumbs li { font-size: 0.875rem; color: var(--color-gray-500); }
.breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); color: var(--color-gray-300); }
.breadcrumbs a { color: var(--color-gray-500); }
.breadcrumbs [aria-current] { color: var(--color-gray-700); font-weight: 500; }
.page-hero { background: var(--color-gray-50); padding: var(--space-12) 0; border-bottom: 1px solid var(--color-gray-200); }
.page-hero h1 { margin-bottom: var(--space-3); }
.page-hero p { color: var(--color-gray-600); max-width: 640px; font-size: 1.0625rem; }
.section { padding: var(--space-12) 0; }
.faq-content { max-width: var(--content-width); }
.faq-content h2 { margin-top: var(--space-8); margin-bottom: var(--space-3); font-size: 1.25rem; }
.faq-content p { color: var(--color-gray-600); }
</style>
