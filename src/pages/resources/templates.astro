---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resource');
const template = resources.find(r => r.data.type === 'template');
const body = template ? template.body : '';
---

<BaseLayout title="Free Field Service Templates for Contractors" description="Downloadable templates for HVAC, plumbing, and electrical contractors.">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/guides/">Resources</a></li><li aria-current="page">Templates</li></ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="container">
      <h1>Free Field Service Templates</h1>
      <p>Standardized templates for HVAC, plumbing, and electrical contractors.</p>
    </div>
  </section>

  <section class="section">
    <div class="container templates-content content">
      <div set:html={body} />
    </div>
  </section>
</BaseLayout>

<style>
.breadcrumbs { padding: var(--space-4) 0; }
.breadcrumbs ol { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin: 0; }
.breadcrumbs li { font-size: 0.875rem; color: var(--color-gray-500); }
.breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); color: var(--color-gray-300); }
.breadcrumbs a { color: var(--color-gray-500); }
.breadcrumbs [aria-current] { color: var(--color-gray-700); font-weight: 500; }
.page-hero { background: var(--color-gray-50); padding: var(--space-12) 0; border-bottom: 1px solid var(--color-gray-200); }
.page-hero h1 { margin-bottom: var(--space-3); }
.page-hero p { color: var(--color-gray-600); max-width: 640px; font-size: 1.0625rem; }
.section { padding: var(--space-12) 0; }
.templates-content { line-height: 1.7; }
.templates-content p { margin-bottom: var(--space-4); }
</style>
