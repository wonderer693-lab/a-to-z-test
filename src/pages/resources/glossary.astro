---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resource');
const glossary = resources.find(r => r.data.type === 'glossary');
const body = glossary ? glossary.body : '';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Field Service Software Glossary",
  "description": "Definitions of common field service management software terms.",
};
---

<BaseLayout title="Field Service Software Glossary - Terms & Definitions" description="Glossary of field service management software terminology. Definitions of common terms for HVAC, plumbing, and electrical contractors." jsonLd={schema}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/guides/">Resources</a></li><li aria-current="page">Glossary</li></ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="container">
      <h1>Field Service Software Glossary</h1>
      <p>Common terms and definitions for field service management software and contractor operations.</p>
    </div>
  </section>

  <section class="section">
    <div class="container glossary-content">
      <div set:html={body} />
    </div>
  </section>
</BaseLayout>

<style>
.breadcrumbs { padding: var(--space-4) 0; }
.breadcrumbs ol { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin: 0; }
.breadcrumbs li { font-size: 0.875rem; color: var(--color-gray-500); }
.breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: var(--space-2); color: var(--color-gray-300); }
.breadcrumbs a { color: var(--color-gray-500); }
.breadcrumbs [aria-current] { color: var(--color-gray-700); font-weight: 500; }
.page-hero { background: var(--color-gray-50); padding: var(--space-12) 0; border-bottom: 1px solid var(--color-gray-200); }
.page-hero h1 { margin-bottom: var(--space-3); }
.page-hero p { color: var(--color-gray-600); max-width: 640px; font-size: 1.0625rem; }
.section { padding: var(--space-12) 0; }
.glossary-content { max-width: var(--content-width); }
.glossary-content p { margin-bottom: var(--space-4); }
.glossary-content strong { color: var(--color-gray-900); }
</style>
