---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found - FieldServicePros" description="The page you are looking for does not exist." noindex={true}>
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <h1>Page Not Found</h1>
        <p>The page you are looking for does not exist or has been moved.</p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">Go Home</a>
          <a href="/comparisons/" class="btn btn-outline">Browse Comparisons</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.error-page {
  padding: var(--space-16) 0;
  text-align: center;
}
.error-content {
  max-width: 480px;
  margin: 0 auto;
}
.error-content h1 {
  font-size: 3rem;
  margin-bottom: var(--space-4);
}
.error-content p {
  color: var(--color-gray-500);
  font-size: 1.125rem;
  margin-bottom: var(--space-8);
}
.error-actions {
  display: flex;
  gap: var(--space-4);
  justify-content: center;
}
</style>
